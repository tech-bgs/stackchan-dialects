{
  "include": ["./manifest.json", "./manifest_camera.json"],
  "preload": ["embedded:io/system"],
  "modules": {
    "embedded:io/system": "$(MODDABLE)/modules/io/system/system"
  },
  "build": {
    "C_FLAGS_SUBPLATFORM": "-I$(IDF_PATH)/components/sdmmc/include\\t-I$(IDF_PATH)/components/esp_driver_sdspi/include\\t-I$(IDF_PATH)/components/fatfs/vfs/include"
  },
  "dependency": [
    { "idf": "fatfs" },
    { "idf": "wear_levelling" },
    { "idf": "sdmmc" },
    { "idf": "esp_driver_sdspi" },
    { "idf": "driver" }
  ],
  "platforms": {
    "esp32/m5stack_cores3": {
      "creation": {
        "static": 0,
        "chunk": {
          "initial": 819200,
          "incremental": 0
        },
        "heap": {
          "initial": 6144,
          "incremental": 256
        },
        "stack": 512,
        "keys": {
          "initial": 32,
          "incremental": 32
        }
      },
      "modules": {
        "setup/target": "./m5stack-cores3-setup-target",
        "m5stack-cores3/setup-target": "./m5stack-cores3-setup-target"
      }
    },
    "esp32/m5stackchan_cores3": {
      "creation": {
        "static": 0,
        "chunk": {
          "initial": 819200,
          "incremental": 0
        },
        "heap": {
          "initial": 6144,
          "incremental": 256
        },
        "stack": 512,
        "keys": {
          "initial": 32,
          "incremental": 32
        }
      },
      "modules": {
        "setup/target": "./m5stack-cores3-setup-target",
        "m5stack-cores3/setup-target": "./m5stack-cores3-setup-target"
      }
    }
  },
  "config": {
    "driver": {
      "type": "m5stackchan",
      "panId": 1,
      "tiltId": 2,
      "yawZeroPosition": 460,
      "pitchZeroPosition": 620,
      "serial": {
        "transmit": 6,
        "receive": 7,
        "port": 1,
        "baud": 1000000
      },
      "servoPower": {
        "type": "py32",
        "pin": 0,
        "address": 111
      }
    },
    "led": {
      "head": {
        "type": "py32",
        "length": 12,
        "ledPin": 13,
        "address": 111
      }
    },
    "touchIntervalMs": 50,
    "virtualButton": false
  }
}
